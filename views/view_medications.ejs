<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prescribed Medications</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container { max-width: 800px; margin: 0 auto; }
        
        header {
            background: white;
            border-radius: 12px;
            padding: 28px;
            margin-bottom: 28px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
            border-left: 4px solid #667eea;
        }
        
        h1 {
            color: #1a202c;
            font-size: 24px;
            margin-bottom: 8px;
            font-weight: 700;
        }
        
        .appointment-date {
            color: #718096;
            font-size: 14px;
        }
        
        .content {
            background: white;
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
            margin-bottom: 24px;
        }
        
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #718096;
        }
        
        .empty-state-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }
        
        .medications-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        
        .medication-card {
            background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 20px;
            transition: all 0.3s;
            border-left: 4px solid #667eea;
        }
        
        .medication-card:hover {
            box-shadow: 0 8px 12px rgba(102, 126, 234, 0.15);
            transform: translateY(-2px);
        }
        
        .medication-name {
            font-size: 18px;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .medication-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 12px;
        }
        
        .detail {
            display: flex;
            flex-direction: column;
        }
        
        .detail-label {
            font-size: 12px;
            color: #718096;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        
        .detail-value {
            font-size: 15px;
            color: #2d3748;
            font-weight: 600;
        }
        
        .notes {
            background: white;
            padding: 12px;
            border-radius: 6px;
            font-size: 14px;
            color: #4a5568;
            line-height: 1.6;
            font-style: italic;
            border-left: 2px solid #fbbf24;
        }
        
        .back-button {
            display: inline-block;
            padding: 12px 24px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
            margin-bottom: 24px;
        }
        
        .back-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 12px rgba(102, 126, 234, 0.3);
        }
        
        @media (max-width: 640px) {
            .medication-details {
                grid-template-columns: 1fr;
            }
            h1 {
                font-size: 20px;
            }
            .content {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/home" class="back-button">← Back to Dashboard</a>
        
        <!-- Modern medication header -->
        <header>
            <h1>Prescribed Medications</h1>
            <p class="appointment-date">
                Appointment: <%= new Date(appointment.appointment_date).toLocaleString('en-US', { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }) %>
            </p>
        </header>

        <!-- Modern medications display -->
        <div class="content">
            <% if (medications.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-state-icon">💊</div>
                    <p>Your doctor hasn't prescribed any medications for this appointment yet.</p>
                </div>
            <% } else { %>
                <div class="medications-list">
                    <% medications.forEach(function(med, idx) { %>
                        <div class="medication-card">
                            <div class="medication-name">
                                <%= med.medication_name %>
                            </div>
                            <div class="medication-details">
                                <div class="detail">
                                    <span class="detail-label">Dosage</span>
                                    <span class="detail-value"><%= med.dosage %></span>
                                </div>
                                <div class="detail">
                                    <span class="detail-label">Medication #<%= idx + 1 %></span>
                                    <span class="detail-value">✓ Active</span>
                                </div>
                            </div>
                            <% if (med.notes) { %>
                                <div class="notes">
                                    <strong>Notes:</strong> <%= med.notes %>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>
     <%- include('partials/chatbot') %>
</body>
</html>
