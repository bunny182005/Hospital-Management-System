<!-- views/partials/chatbot.ejs -->
<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes typewriter {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  @keyframes blinkCursor {
    50% {
      border-right-color: transparent;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .message-user {
    animation: fadeInUp 0.4s ease-out;
    background: #f0f0f0;
    padding: 8px 12px;
    margin: 8px 0;
    border-radius: 8px;
    text-align: right;
    color: #333;
  }

  .message-bot {
    animation: slideIn 0.5s ease-out;
    background: #e3f2fd;
    padding: 8px 12px;
    margin: 8px 0;
    border-radius: 8px;
    color: #333;
  }

  .typing-indicator {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .typing-indicator span {
    width: 8px;
    height: 8px;
    background: #667eea;
    border-radius: 50%;
    animation: pulse 1.4s infinite;
  }

  .typing-indicator span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing-indicator span:nth-child(3) {
    animation-delay: 0.4s;
  }

  .animated-text {
    display: inline-block;
    animation: typewriter 0.8s steps(20, end);
    overflow: hidden;
    white-space: nowrap;
    border-right: 3px solid #667eea;
    animation: typewriter 0.8s steps(20, end), blinkCursor 0.75s step-end infinite;
  }

  #chatbot-icon {
    animation: fadeInUp 0.6s ease-out;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #chatbot-icon:hover {
    transform: scale(1.1);
    box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
  }
</style>

<div id="chatbot-icon" style="
  position: fixed;
  bottom: 20px;
  right: 20px;
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: white;
  font-size: 26px;
  cursor: pointer;
  box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  z-index: 9999;
">💬</div>

<div id="chat-window" style="
  position: fixed;
  bottom: 90px;
  right: 20px;
  width: 420px;
  max-height: 500px;
  background: white;
  border: 1px solid #ddd;
  border-radius: 12px;
  box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  display: none;
  flex-direction: column;
  overflow: hidden;
  z-index: 10000;
  font-family: system-ui, sans-serif;
  animation: fadeInUp 0.5s ease-out;
">
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 12px; font-weight: 600; text-align: center;">
    🏥 MediCare Assistant
  </div>
  <div id="chat-messages" style="flex:1; padding: 12px; overflow-y:auto; font-size:14px;"></div>
  <div style="display:flex; padding:10px; border-top:1px solid #eee;">
    <input id="user-message" type="text" placeholder="Type your message..." style="flex:1; border:1px solid #ccc; border-radius:8px; padding:8px; font-size:14px;">
    <button id="send-button" style="margin-left:6px; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:white; border:none; padding:8px 12px; border-radius:8px; cursor:pointer; transition: all 0.3s ease;">Send</button>
  </div>
</div>

<script>
  const icon = document.getElementById('chatbot-icon');
  const windowEl = document.getElementById('chat-window');
  const messagesEl = document.getElementById('chat-messages');
  const sendBtn = document.getElementById('send-button');
  const inputEl = document.getElementById('user-message');
  let history = [];

  function showTypingIndicator() {
    const typingDiv = document.createElement('div');
    typingDiv.className = 'message-bot';
    typingDiv.id = 'typing-indicator';
    typingDiv.innerHTML = '<div class="typing-indicator"><span></span><span></span><span></span></div>';
    messagesEl.appendChild(typingDiv);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function removeTypingIndicator() {
    const typingDiv = document.getElementById('typing-indicator');
    if (typingDiv) typingDiv.remove();
  }

  function typeMessage(element, text, speed = 30) {
    return new Promise((resolve) => {
      let index = 0;
      const type = () => {
        if (index < text.length) {
          element.innerHTML += text.charAt(index);
          index++;
          setTimeout(type, speed);
        } else {
          resolve();
        }
      };
      type();
    });
  }

  icon.addEventListener('click', () => {
    windowEl.style.display = windowEl.style.display === 'none' ? 'flex' : 'none';
  });

  sendBtn.addEventListener('click', async () => {
    const userMsg = inputEl.value.trim();
    if (!userMsg) return;
    
    history.push({ role: 'user', content: userMsg });
    
    const userDiv = document.createElement('div');
    userDiv.className = 'message-user';
    userDiv.innerHTML = `<b>You:</b> ${userMsg}`;
    messagesEl.appendChild(userDiv);
    inputEl.value = '';
    messagesEl.scrollTop = messagesEl.scrollHeight;

    showTypingIndicator();

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: userMsg })
      });
      const data = await res.json();
      const botReply = data.response || data.error || "No response from bot.";
      
      removeTypingIndicator();
      history.push({ role: 'bot', content: data.response });
      
      const botDiv = document.createElement('div');
      botDiv.className = 'message-bot';
      botDiv.innerHTML = `<b>Bot:</b> `;
      messagesEl.appendChild(botDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      
      await typeMessage(botDiv, data.response, 25);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    } catch (err) {
      removeTypingIndicator();
      const errorDiv = document.createElement('div');
      errorDiv.className = 'message-bot';
      errorDiv.style.color = 'red';
      errorDiv.innerHTML = `<b>Error:</b> Unable to connect to chatbot.`;
      messagesEl.appendChild(errorDiv);
    }
  });

  inputEl.addEventListener('keypress', e => {
    if (e.key === 'Enter') sendBtn.click();
  });
</script>
